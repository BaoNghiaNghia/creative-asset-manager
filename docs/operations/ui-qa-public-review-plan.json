{
  "viewports": [
    "desktop",
    "tabletPortrait",
    "mobile"
  ],
  "qualityBudgets": {
    "desktop": {"maxUnnamedControls": 0, "maxMissingAlt": 0},
    "tabletPortrait": {"maxUnnamedControls": 0, "maxMissingAlt": 0},
    "mobile": {"maxUnnamedControls": 0, "maxMissingAlt": 0}
  },
  "steps": [
    {
      "name": "default",
      "waitFor": ".public-grid",
      "waitMs": 500
    },
    {
      "name": "public-card-hover",
      "hover": ".public-media-card"
    },
    {
      "name": "public-search-focus",
      "focus": ".public-search-field input"
    },
    {
      "name": "public-media-open",
      "resetBefore": true,
      "click": ".public-media-card .public-card-comment-action",
      "waitFor": ".public-viewer",
      "waitMs": 300
    },
    {
      "name": "public-editor-typing",
      "waitFor": ".public-tiptap",
      "fill": {"selector": ".public-tiptap", "value": "TipTap 3 QA comment"},
      "waitMs": 100,
      "assertions": [
        {"type": "text-includes", "selector": ".public-tiptap", "value": "TipTap 3 QA comment"},
        {"type": "visible", "selector": ".public-editor-submit:not([disabled])"},
        {"type": "no-viewport-overflow", "selector": "body"}
      ]
    },
    {
      "name": "public-editor-emoji-picker",
      "click": ".public-editor-emoji-toggle",
      "assertions": [
        {"type": "visible", "selector": ".public-emoji-picker"},
        {"type": "no-viewport-overflow", "selector": "body"}
      ]
    }
  ]
}
