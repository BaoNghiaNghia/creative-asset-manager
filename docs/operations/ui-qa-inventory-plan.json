{
  "viewports": [
    "desktop",
    "tabletPortrait",
    "mobile"
  ],
  "qualityBudgets": {
    "desktop": {
      "maxUnnamedControls": 0,
      "maxMissingAlt": 0
    },
    "tabletPortrait": {
      "maxUnnamedControls": 0,
      "maxMissingAlt": 0
    },
    "mobile": {
      "maxUnnamedControls": 0,
      "maxMissingAlt": 0
    }
  },
  "steps": [
    {
      "name": "overview-ready",
      "waitFor": "main.inventory-workspace .ops-inventory-daily",
      "waitMs": 300,
      "requireIcons": [
        ".ops-inventory-refresh-action"
      ]
    },
    {
      "name": "status-hover",
      "hover": ".ops-inventory-summary-card.processing-date"
    },
    {
      "name": "status-refresh-focus",
      "focus": ".ops-inventory-refresh-action"
    },
    {
      "name": "status-refresh",
      "click": ".ops-inventory-refresh-action",
      "waitFor": ".ops-inventory-summary-card.run",
      "waitMs": 300
    },
    {
      "name": "human-attestation-collapsed",
      "click": ".ops-inventory-human-actions:not([open]) > summary",
      "press": {
        "selector": ".ops-inventory-human-actions[open] > summary",
        "key": "Enter"
      },
      "waitFor": ".ops-inventory-human-actions:not([open]) > summary",
      "waitMs": 100
    }
  ]
}
