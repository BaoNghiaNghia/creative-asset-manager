{
  "viewports": [
    "desktop",
    "compact",
    "tabletLandscape",
    "tabletPortrait",
    "mobile",
    "mobileSmall"
  ],
  "steps": [
    {
      "name": "writeback-preflight-control",
      "waitFor": ".inventory-settings-actions-card .inventory-actions button:nth-child(3)",
      "waitMs": 200,
      "assertions": [
        {
          "type": "text-includes",
          "selector": ".inventory-settings-actions-card .inventory-actions button:nth-child(3)",
          "value": "Kiểm tra quyền bản sao"
        },
        {
          "type": "text-includes",
          "selector": ".inventory-settings-actions-card .inventory-actions button:nth-child(4)",
          "value": "Chạy QA ghi trên bản sao"
        },
        {
          "type": "attribute",
          "selector": ".inventory-settings-actions-card .inventory-actions button:nth-child(4)",
          "name": "disabled",
          "value": ""
        }
      ]
    },
    {
      "name": "writeback-preflight-focus",
      "focus": ".inventory-settings-actions-card .inventory-actions button:nth-child(3)",
      "assertions": [
        {
          "type": "visible",
          "selector": ".inventory-settings-actions-card .inventory-actions button:nth-child(3)"
        },
        {
          "type": "no-viewport-overflow",
          "selector": "html",
          "maxPx": 0
        },
        {
          "type": "attribute",
          "selector": ".inventory-settings-actions-card .inventory-actions button:nth-child(4)",
          "name": "disabled",
          "value": ""
        }
      ]
    }
  ]
}
