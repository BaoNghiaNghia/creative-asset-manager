{
  "viewports": [
    "desktop",
    "compact",
    "tabletLandscape",
    "tabletPortrait",
    "mobile",
    "mobileSmall"
  ],
  "steps": [
    {
      "name": "overview-default",
      "waitFor": "main.inventory-workspace .ops-inventory-summary-card.run",
      "waitMs": 350
    },
    {
      "name": "stage-hover",
      "hover": ".ops-inventory-grid .ops-inventory-card:first-child"
    },
    {
      "name": "refresh-focus",
      "focus": ".ops-inventory-refresh-action"
    },
    {
      "name": "exception-summary-toggle",
      "click": ".ops-inventory-human-actions > summary",
      "waitFor": ".ops-inventory-human-buttons",
      "waitMs": 120
    }
  ]
}
