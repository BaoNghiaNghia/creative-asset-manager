{
  "viewports": [
    "desktop",
    "tabletPortrait",
    "mobile"
  ],
  "qualityBudgets": {
    "desktop": {
      "maxViewportOverflowPx": 0,
      "maxSmallTargets": 0,
      "maxUnnamedControls": 0,
      "maxMissingAlt": 0
    },
    "tabletPortrait": {
      "maxViewportOverflowPx": 0,
      "maxSmallTargets": 0,
      "maxUnnamedControls": 0,
      "maxMissingAlt": 0
    },
    "mobile": {
      "maxViewportOverflowPx": 0,
      "maxUnnamedControls": 0,
      "maxMissingAlt": 0,
      "maxSmallTargets": 0
    }
  },
  "mobileAssertions": [
    {
      "type": "no-viewport-overflow",
      "selector": "html",
      "maxPx": 0
    }
  ],
  "steps": [
    {
      "name": "reviews-workflow",
      "goto": "/realistic-review-ugc?workflow=reviews&stage=stage3",
      "waitFor": "#rrugc-tab-stage3"
    },
    {
      "name": "cap-stack-stage1",
      "click": "#rrugc-tab-reviews-stage1",
      "waitFor": "#rrugc-panel-reviews-stage1 .rrugc-cap-stack-stage",
      "mobileAssertions": [
        {"type":"min-control-size","selector":"#rrugc-panel-reviews-stage1 .rrugc-cap-stack-preview","minPx":24}
      ],
      "assertions": [
        {"type":"text-includes","selector":"#rrugc-panel-reviews-stage1","value":"Cap Stack Scout"},
        {"type":"visible","selector":"#rrugc-panel-reviews-stage1 .rrugc-cap-stack-summary"},
        {"type":"visible","selector":"#rrugc-panel-reviews-stage1 .rrugc-cap-stack-gallery"},
        {"type":"visible","selector":"#rrugc-panel-reviews-stage1 .rrugc-cap-stack-toolbar"}
      ]
    },
    {
      "name": "default",
      "click": "#rrugc-tab-stage3",
      "waitFor": "#rrugc-source-plans",
      "waitMs": 300,
      "mobileAssertions": [
        {
          "type": "min-control-size",
          "selector": ".rrugc-source-ref-arrow",
          "minPx": 24
        }
      ],
      "requireIcons": [
        "#rrugc-panel-stage3 .rrugc-source-plan-heading-actions button",
        "#rrugc-panel-stage3 .rrugc-source-plan-sort-direction"
      ]
    },
    {
      "name": "stage3-sort-controls",
      "waitFor": "#rrugc-panel-stage3 .rrugc-source-plan-sort select"
    },
    {
      "name": "campaign-hover",
      "hover": ".rrugc-source-plan-table tbody tr"
    },
    {
      "name": "candidate-hover",
      "hover": ".rrugc-source-ref-card"
    },
    {
      "name": "candidate-review-open",
      "click": ".rrugc-source-ref-open",
      "waitFor": ".rrugc-source-review-modal .rrugc-source-review-votes",
      "mobileAssertions": [
        {
          "type": "min-control-size",
          "selector": ".rrugc-source-review-modal .rrugc-source-review-vote",
          "minPx": 24
        }
      ]
    },
    {
      "name": "candidate-review-close",
      "click": ".rrugc-source-review-close",
      "waitFor": "#rrugc-stage3-search-input"
    },
    {
      "name": "candidate-filter-focus",
      "focus": "#rrugc-stage3-search-input"
    },
    {
      "name": "products-workflow",
      "goto": "/realistic-review-ugc?workflow=products&stage=stage0",
      "waitFor": "#rrugc-tab-stage0"
    },
    {
      "name": "stage0-sort-column-highlight",
      "waitFor": "#rrugc-panel-stage0 .rrugc-stage0-keyword-table[data-sort-column][data-sort-direction] thead th[aria-sort]"
    },
    {
      "name": "stage1-actions",
      "click": "#rrugc-tab-stage1",
      "waitFor": "#rrugc-panel-stage1 .rrugc-keyword-gen-trend .rrugc-stage0-sparkline",
      "waitMs": 200,
      "requireIcons": [
        "#rrugc-panel-stage1 .rrugc-keyword-gen-actions button",
        "#rrugc-panel-stage1 .rrugc-keyword-manual-controls button"
      ],
      "assertions": [
        {
          "type": "text-includes",
          "selector": "#rrugc-panel-stage1 .rrugc-keyword-gen-sort.active .rrugc-sort-indicator",
          "value": "↓"
        },
        {
          "type": "no-horizontal-overflow",
          "selector": ".rrugc-keyword-gen-trend .rrugc-stage0-trend",
          "maxPx": 1
        },
        {
          "type": "no-horizontal-overflow",
          "selector": ".rrugc-keyword-gen-trend",
          "maxPx": 1
        },
        {
          "type": "no-horizontal-overflow",
          "selector": ".rrugc-keyword-gen-volume",
          "maxPx": 1
        },
        {
          "type": "text-includes",
          "selector": ".rrugc-keyword-gen-skill select",
          "value": "18_39_12_10_26"
        }
      ]
    },
    {
      "name": "stage2-actions",
      "click": "#rrugc-tab-stage2",
      "waitFor": "#rrugc-panel-stage2 .rrugc-colorway-stage",
      "requireIcons": [
        "#rrugc-panel-stage2 .rrugc-colorway-header-actions button",
        "#rrugc-panel-stage2 .rrugc-colorway-toolbar > button"
      ]
    },
    {
      "name": "stage2-sort-controls",
      "waitFor": "#rrugc-panel-stage2 .rrugc-stage-sort select",
      "assertions": [{"type":"text-includes","selector":"#rrugc-panel-stage2 .rrugc-stage-sort select","value":"Last updated"}]
    },
    {
      "name": "stage2-sort-column-highlight",
      "waitFor": "#rrugc-panel-stage2 .rrugc-colorway-table[data-sort-column='source'] thead th.is-sort-column"
    },
    {
      "name": "reviews-workflow-return",
      "goto": "/realistic-review-ugc?workflow=reviews&stage=stage3",
      "waitFor": "#rrugc-tab-stage3"
    },
    {
      "name": "reviews-stage2-actions",
      "click": "#rrugc-tab-reviews-stage2",
      "waitFor": "#rrugc-panel-reviews-stage2 .rrugc-colorway-stage",
      "requireIcons": [
        "#rrugc-panel-reviews-stage2 .rrugc-colorway-header-actions button"
      ]
    },
    {
      "name": "stage4-actions",
      "click": "#rrugc-tab-stage4",
      "waitFor": "#rrugc-panel-stage4 .rrugc-stage2",
      "mobileAssertions": [
        {
          "type": "min-control-size",
          "selector": ".rrugc-stage2-ref-toggle",
          "minPx": 24
        }
      ],
      "requireIcons": [
        "#rrugc-panel-stage4 .rrugc-stage2-registry-actions button"
      ]
    },
    {
      "name": "stage4-codex-manager-open",
      "click": ".rrugc-global-management-actions [data-codex-accounts-open]",
      "waitFor": ".rrugc-codex-pool-dialog",
      "assertions": [
        {"type": "text-includes", "selector": ".rrugc-codex-pool-banner", "value": "Routing: Primary account"},
        {"type": "text-includes", "selector": ".rrugc-codex-pool-dialog", "value": "Account 02"}
      ]
    },
    {
      "name": "stage4-codex-manager-close",
      "click": ".rrugc-codex-pool-close",
      "waitFor": "#rrugc-panel-stage4 .rrugc-stage2"
    },
    {
      "name": "stage4-sort-controls",
      "waitFor": "#rrugc-panel-stage4 .rrugc-stage-sort select",
      "assertions": [{"type":"text-includes","selector":"#rrugc-panel-stage4 .rrugc-stage-sort select","value":"Active jobs"}]
    },
    {
      "name": "stage4-regenerate-preview",
      "click": "#rrugc-panel-stage4 .rrugc-stage2-result-open",
      "waitFor": ".rrugc-stage4-output-modal .rrugc-stage4-output-card-actions",
      "waitMs": 200
    },
    {
      "name": "stage4-regenerate-confirm",
      "click": ".rrugc-stage4-output-modal .rrugc-stage4-output-card-actions .is-new-version",
      "waitFor": ".rrugc-stage4-regenerate-confirm",
      "assertions": [
        {"type": "text-includes", "selector": ".rrugc-stage4-regenerate-confirm", "value": "All previous outputs will remain available"}
      ]
    },
    {
      "name": "stage4-regenerate-cancel",
      "click": ".rrugc-stage4-regenerate-confirm footer button:not(.is-accept)",
      "waitFor": ".rrugc-stage4-output-modal"
    },
    {
      "name": "stage4-regenerate-close",
      "click": ".rrugc-stage4-output-modal .rrugc-source-review-close",
      "waitFor": "#rrugc-panel-stage4 .rrugc-stage2"
    },
    {
      "name": "stage5-actions",
      "click": "#rrugc-tab-stage5",
      "waitFor": "#rrugc-panel-stage5 .rrugc-stage3",
      "requireIcons": [
        "#rrugc-panel-stage5 .rrugc-stage5-toolbar-actions > button"
      ],
      "assertions": [
        {"type":"visible","selector":"#rrugc-panel-stage5 .rrugc-stage5-toolbar .rrugc-stage5-toolbar-stats"},
        {"type":"visible","selector":"#rrugc-panel-stage5 .rrugc-stage5-toolbar .rrugc-stage5-sort-bar"},
        {"type":"single-row-within","selector":"#rrugc-panel-stage5 .rrugc-stage5-toolbar","minViewportPx":1280,
         "items":[".rrugc-stage5-search-group",".rrugc-stage5-sort-bar",".rrugc-stage5-toolbar-actions",".rrugc-stage5-toolbar-stats"]},
        {"type":"hidden","selector":"#rrugc-panel-stage5 .rrugc-stage5-folder-summary"}
      ]
    },
    {
      "name": "stage5-sort-controls",
      "waitFor": "#rrugc-panel-stage5 .rrugc-stage5-sort-label select",
      "assertions": [{"type":"text-includes","selector":"#rrugc-panel-stage5 .rrugc-stage5-sort-label select","value":"Highest UGC score"}]
    },
    {
      "name": "stage5-source-tree",
      "goto": "/realistic-review-ugc?workflow=reviews&stage=stage5",
      "waitFor": "#rrugc-panel-stage5 .rrugc-stage5-source-tree .rrugc-stage5-tree-all",
      "assertions": [
        {"type":"text-includes","selector":"#rrugc-panel-stage5 .rrugc-stage5-source-tree","value":"Source tree"},
        {"type":"text-includes","selector":"#rrugc-panel-stage5 .rrugc-stage5-tree-all","value":"All folders"},
        {"type":"no-horizontal-overflow","selector":"#rrugc-panel-stage5 .rrugc-stage5-tree-scroll","maxPx":0},
        {"type":"visible","selector":"#rrugc-panel-stage5 .rrugc-stage5-folder-content .rrugc-stage3-image"}
      ]
    },
    {
      "name": "stage5-parent-folder",
      "click": "#rrugc-panel-stage5 .rrugc-stage5-tree-folder[title='QA']",
      "waitFor": "#rrugc-panel-stage5 .rrugc-stage5-tree-folder[title='QA/Stage 5']",
      "assertions": [
        {"type":"attribute","selector":"#rrugc-panel-stage5 .rrugc-stage5-tree-folder[title='QA']","name":"aria-pressed","value":"true"}
      ]
    },
    {
      "name": "stage5-child-folder",
      "click": "#rrugc-panel-stage5 .rrugc-stage5-tree-folder[title='QA/Stage 5']",
      "waitFor": "#rrugc-panel-stage5 .rrugc-stage5-tree-folder[title='QA/Stage 5']",
      "assertions": [
        {"type":"attribute","selector":"#rrugc-panel-stage5 .rrugc-stage5-tree-folder[title='QA/Stage 5']","name":"aria-pressed","value":"true"}
      ]
    },
    {
      "name": "stage5-all-folders",
      "click": "#rrugc-panel-stage5 .rrugc-stage5-tree-all",
      "waitFor": "#rrugc-panel-stage5 .rrugc-stage5-folder-content .rrugc-stage3-gallery",
      "assertions": [
        {"type":"attribute","selector":"#rrugc-panel-stage5 .rrugc-stage5-tree-all","name":"aria-pressed","value":"true"}
      ]
    },
    {
      "name": "stage5-before-after-modal",
      "click": "#rrugc-panel-stage5 .rrugc-stage3-image.is-clickable",
      "waitFor": ".rrugc-stage5-ba-switch",
      "assertions": [
        {"type": "text-includes", "selector": ".rrugc-stage5-ba-switch", "value": "Compare"}
      ]
    },
    {
      "name": "stage5-pinterest-reference-choice",
      "waitFor": ".rrugc-stage5-ba-reference-choice select"
    },
    {
      "name": "stage5-compare-slider",
      "click": ".rrugc-stage5-ba-switch button:last-child",
      "waitFor": ".rrugc-stage5-ba-range"
    },
    {
      "name": "stage5-original-photo",
      "click": ".rrugc-stage5-ba-switch button:nth-child(2)",
      "waitFor": ".rrugc-stage5-ba.is-before"
    }
  ]
}
