{
  "schemaVersion": 1,
  "viewports": [
    {
      "name": "desktop",
      "width": 1440,
      "height": 900
    },
    {
      "name": "tablet",
      "width": 768,
      "height": 1024
    },
    {
      "name": "mobile",
      "width": 390,
      "height": 844
    }
  ],
  "routes": [
    {
      "name": "branding-dna-worker-control",
      "path": "/branding-dna",
      "public": false,
      "requiresAuth": true,
      "ready": "main.branding-dna-page",
      "forbiddenText": [
        "Under Construction",
        "Sign in required",
        "Internal Server Error"
      ],
      "states": [
        {
          "name": "foundation-and-worker",
          "waitFor": ".bdna-worker-manager",
          "assertions": [
            {
              "type": "visible",
              "selector": ".bdna-live-section"
            },
            {
              "type": "visible",
              "selector": ".bdna-worker-list"
            },
            {
              "type": "no-viewport-overflow",
              "selector": "body",
              "maxPx": 1
            }
          ],
          "waitMs": 1000
        },
        {
          "name": "add-shop-form",
          "click": ".bdna-live-heading button",
          "waitFor": ".bdna-shop-form",
          "assertions": [
            {
              "type": "visible",
              "selector": ".bdna-shop-form-url input"
            },
            {
              "type": "no-viewport-overflow",
              "selector": "body",
              "maxPx": 1
            }
          ],
          "waitMs": 250
        }
      ]
    }
  ]
}
