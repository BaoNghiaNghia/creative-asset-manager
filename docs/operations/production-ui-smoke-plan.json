{
  "schemaVersion": 1,
  "viewports": [
    {
      "name": "desktop",
      "width": 1440,
      "height": 900
    },
    {
      "name": "tabletPortrait",
      "width": 768,
      "height": 1024
    },
    {
      "name": "mobile",
      "width": 390,
      "height": 844
    }
  ],
  "routes": [
    {
      "name": "privacy",
      "path": "/privacy-policy",
      "public": true,
      "requiresAuth": false,
      "ready": "main",
      "states": [
        {
          "name": "default"
        }
      ]
    },
    {
      "name": "terms",
      "path": "/terms-of-service",
      "public": true,
      "requiresAuth": false,
      "ready": "main",
      "states": [
        {
          "name": "default"
        }
      ]
    },
    {
      "name": "asset-explorer",
      "path": "/",
      "public": false,
      "requiresAuth": true,
      "ready": "main.shell.product-shell",
      "forbiddenText": [
        "This workspace is not available for your role.",
        "Sign in required"
      ],
      "states": [
        {
          "name": "default"
        },
        {
          "name": "search-focus",
          "focus": "input[aria-label='Search images and videos']",
          "optional": true
        },
        {
          "name": "first-card-hover",
          "hover": ".grid article:first-child",
          "optional": true
        }
      ]
    },
    {
      "name": "review-board",
      "path": "/review-board",
      "public": false,
      "requiresAuth": true,
      "ready": "main.review-board-shell",
      "forbiddenText": [
        "This workspace is not available for your role.",
        "Sign in required"
      ],
      "states": [
        {
          "name": "default"
        },
        {
          "name": "first-issue-hover",
          "hover": ".review-board-row:first-child",
          "optional": true
        }
      ]
    },
    {
      "name": "inventory",
      "path": "/inventory",
      "public": false,
      "requiresAuth": true,
      "ready": "main.inventory-workspace",
      "forbiddenText": [
        "This workspace is not available for your role.",
        "Sign in required"
      ],
      "states": [
        {
          "name": "daily-overview",
          "assertions": [
            {
              "type": "visible",
              "selector": ".inventory-workspace-content"
            },
            {
              "type": "no-viewport-overflow",
              "selector": "body"
            }
          ]
        }
      ]
    },
    {
      "name": "ai-operations",
      "path": "/ai-operations",
      "public": false,
      "requiresAuth": true,
      "ready": ".ops-content",
      "forbiddenText": [
        "This workspace is not available for your role.",
        "Sign in required"
      ],
      "states": [
        {
          "name": "default",
          "assertions": [
            {
              "type": "visible",
              "selector": ".ops-tabs-carousel"
            },
            {
              "type": "no-viewport-overflow",
              "selector": "body"
            }
          ]
        },
        {
          "name": "tab-pipeline",
          "click": "[data-ops-tab='pipeline']",
          "waitFor": "#ops-panel-pipeline",
          "assertions": [
            {
              "type": "visible",
              "selector": "#ops-panel-pipeline"
            }
          ]
        },
        {
          "name": "tab-visual-search",
          "click": "[data-ops-tab='visual-search']",
          "waitFor": "#ops-panel-visual-search",
          "assertions": [
            {
              "type": "visible",
              "selector": "#ops-panel-visual-search"
            }
          ]
        },
        {
          "name": "tab-creative-pipeline",
          "click": "[data-ops-tab='creative-pipeline']",
          "waitFor": "#ops-panel-creative-pipeline",
          "assertions": [
            {
              "type": "visible",
              "selector": "#ops-panel-creative-pipeline"
            }
          ]
        }
      ]
    },
    {
      "name": "branding-dna",
      "path": "/branding-dna",
      "public": false,
      "requiresAuth": true,
      "ready": ".bdna-stage-tabs",
      "forbiddenText": [
        "This workspace is not available for your role.",
        "Sign in required"
      ],
      "states": [
        {
          "name": "overview",
          "assertions": [
            {
              "type": "visible",
              "selector": ".bdna-stage-panel"
            },
            {
              "type": "no-viewport-overflow",
              "selector": "body"
            }
          ]
        },
        {
          "name": "shop-library",
          "click": "#bdna-stage-shops",
          "waitFor": "#bdna-panel-shops .bdna-live-section",
          "assertions": [
            {
              "type": "visible",
              "selector": "#bdna-panel-shops .bdna-live-section"
            },
            {
              "type": "no-viewport-overflow",
              "selector": "body"
            }
          ]
        },
        {
          "name": "scanner",
          "click": "#bdna-stage-scanner",
          "waitFor": "#bdna-panel-scanner .bdna-worker-manager"
        },
        {
          "name": "product-explorer",
          "click": "#bdna-stage-products",
          "waitFor": "#bdna-panel-products .bdna-future-panel"
        },
        {
          "name": "dna",
          "click": "#bdna-stage-dna",
          "waitFor": "#bdna-panel-dna .bdna-future-panel"
        }
      ]
    },
    {
      "name": "realistic-review-ugc",
      "path": "/realistic-review-ugc",
      "public": false,
      "requiresAuth": true,
      "ready": "main.rrugc-shell",
      "forbiddenText": [
        "This workspace is not available for your role.",
        "Sign in required"
      ],
      "states": [
        {
          "name": "default"
        },
        {
          "name": "stage0-keyword-scout",
          "click": "#rrugc-tab-stage0",
          "waitFor": "#rrugc-panel-stage0",
          "assertions": [
            {
              "type": "visible",
              "selector": "#rrugc-panel-stage0"
            },
            {
              "type": "no-viewport-overflow",
              "selector": "body"
            }
          ]
        },
        {
          "name": "stage1-keyword-generation",
          "click": "#rrugc-tab-stage1",
          "waitFor": "#rrugc-panel-stage1 .rrugc-keyword-gen",
          "assertions": [
            {
              "type": "visible",
              "selector": "#rrugc-panel-stage1 .rrugc-keyword-gen"
            }
          ]
        },
        {
          "name": "stage2-colorways",
          "click": "#rrugc-tab-stage2",
          "waitFor": "#rrugc-panel-stage2 .rrugc-colorway-stage",
          "assertions": [
            {
              "type": "visible",
              "selector": "#rrugc-panel-stage2 .rrugc-colorway-stage"
            }
          ]
        },
        {
          "name": "skill-manager-upload-versions",
          "click": "button.rrugc-global-management-button:has-text(\"Manage skills\")",
          "waitFor": ".rrugc-skill-modal[role=\"dialog\"]",
          "assertions": [
            {
              "type": "visible",
              "selector": ".rrugc-skill-modal .rrugc-skill-catalog-toolbar",
              "timeoutMs": 15000
            },
            {
              "type": "no-viewport-overflow",
              "selector": "body"
            }
          ]
        }
      ]
    },
    {
      "name": "realistic-review-ugc-reviews",
      "path": "/realistic-review-ugc?workflow=reviews&stage=reviews-stage2",
      "public": false,
      "requiresAuth": true,
      "ready": "main.rrugc-shell",
      "forbiddenText": [
        "This workspace is not available for your role.",
        "Sign in required"
      ],
      "states": [
        {
          "name": "default",
          "assertions": [
            {
              "type": "visible",
              "selector": "#rrugc-panel-reviews-stage2 .rrugc-colorway-stage"
            }
          ]
        },
        {
          "name": "stage2-reviews-embroidery",
          "click": "#rrugc-tab-reviews-stage2",
          "waitFor": "#rrugc-panel-reviews-stage2 .rrugc-colorway-stage",
          "assertions": [
            {
              "type": "visible",
              "selector": "#rrugc-panel-reviews-stage2 .rrugc-colorway-stage"
            },
            {
              "type": "no-horizontal-overflow",
              "selector": "#rrugc-panel-reviews-stage2"
            }
          ]
        },
        {
          "name": "stage3-reference-discovery",
          "click": "#rrugc-tab-stage3",
          "waitFor": "#rrugc-panel-stage3 #rrugc-source-plans",
          "assertions": [
            {
              "type": "visible",
              "selector": "#rrugc-panel-stage3 #rrugc-source-plans"
            }
          ]
        },
        {
          "name": "stage4-skill-generation",
          "click": "#rrugc-tab-stage4",
          "waitFor": "#rrugc-panel-stage4 .rrugc-stage2",
          "assertions": [
            {
              "type": "visible",
              "selector": "#rrugc-panel-stage4 .rrugc-stage2"
            }
          ]
        },
        {
          "name": "campaign-hover",
          "hover": ".rrugc-campaign-card:first-child",
          "optional": true
        },
        {
          "name": "stage5-ugc-review",
          "click": "#rrugc-tab-stage5",
          "waitFor": ".rrugc-stage3",
          "assertions": [
            {
              "type": "visible",
              "selector": ".rrugc-stage3"
            },
            {
              "type": "width-ratio",
              "selector": ".rrugc-stage3",
              "relativeTo": "#rrugc-panel-stage5",
              "min": 0.98
            },
            {
              "type": "no-horizontal-overflow",
              "selector": ".rrugc-stage3"
            },
            {
              "type": "no-horizontal-overflow",
              "selector": ".rrugc-stage5-folder-content"
            }
          ]
        }
      ]
    }
  ]
}
