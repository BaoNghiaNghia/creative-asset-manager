{
  "viewports": [
    "desktop",
    "tabletPortrait",
    "mobile"
  ],
  "qualityBudgets": {
    "desktop": {"maxUnnamedControls": 0, "maxMissingAlt": 0},
    "tabletPortrait": {"maxUnnamedControls": 0, "maxMissingAlt": 0},
    "mobile": {"maxUnnamedControls": 0, "maxMissingAlt": 0}
  },
  "steps": [
    {
      "name": "default",
      "waitFor": ".job-queue-table",
      "waitMs": 300
    },
    {
      "name": "queue-row-hover",
      "hover": ".job-queue-table tbody tr"
    },
    {
      "name": "queue-search-focus",
      "focus": ".job-queue-filter-fields input"
    },
    {
      "name": "queue-completed-tab",
      "click": ".job-queue-tabs button:nth-child(4)",
      "waitFor": ".job-queue-table"
    },
    {
      "name": "queue-result-modal",
      "click": ".job-view-result",
      "waitFor": ".generation-result-modal"
    }
  ]
}
