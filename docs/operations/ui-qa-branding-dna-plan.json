{
  "viewports": [
    "desktop",
    "compact",
    "tabletLandscape",
    "tabletPortrait",
    "mobile",
    "mobileSmall"
  ],
  "qualityBudgets": {
    "desktop": {
      "maxViewportOverflowPx": 0,
      "maxUnnamedControls": 0,
      "maxMissingAlt": 0
    },
    "compact": {
      "maxViewportOverflowPx": 0,
      "maxUnnamedControls": 0,
      "maxMissingAlt": 0
    },
    "tabletLandscape": {
      "maxViewportOverflowPx": 0,
      "maxUnnamedControls": 0,
      "maxMissingAlt": 0
    },
    "tabletPortrait": {
      "maxViewportOverflowPx": 0,
      "maxUnnamedControls": 0,
      "maxMissingAlt": 0
    },
    "mobile": {
      "maxViewportOverflowPx": 0,
      "maxUnnamedControls": 0,
      "maxMissingAlt": 0
    },
    "mobileSmall": {
      "maxViewportOverflowPx": 0,
      "maxUnnamedControls": 0,
      "maxMissingAlt": 0
    }
  },
  "steps": [
    {
      "name": "overview-loaded",
      "waitFor": ".bdna-stage-tabs",
      "waitMs": 300,
      "assertions": [
        {
          "type": "attribute",
          "selector": "#bdna-stage-overview",
          "name": "aria-selected",
          "value": "true"
        },
        {
          "type": "count",
          "selector": ".bdna-stage-tabs [role=tab]",
          "value": 6
        },
        {
          "type": "visible",
          "selector": ".bdna-live-section"
        },
        {
          "type": "visible",
          "selector": ".bdna-worker-manager"
        },
        {
          "type": "no-viewport-overflow",
          "selector": "html",
          "maxPx": 0
        }
      ]
    },
    {
      "name": "shops-open",
      "click": "#bdna-stage-shops",
      "waitFor": ".bdna-shop-cards",
      "assertions": [
        {
          "type": "attribute",
          "selector": "#bdna-stage-shops",
          "name": "aria-selected",
          "value": "true"
        },
        {
          "type": "visible",
          "selector": ".bdna-live-section"
        },
        {
          "type": "count",
          "selector": ".bdna-shop-card",
          "value": 2
        },
        {
          "type": "count",
          "selector": ".bdna-shop-blockers",
          "value": 2
        },
        {
          "type": "text-includes",
          "selector": ".bdna-live-info[role=status]",
          "value": "Readiness CAM"
        },
        {
          "type": "no-viewport-overflow",
          "selector": "html",
          "maxPx": 0
        }
      ]
    },
    {
      "name": "add-shop-form",
      "click": ".bdna-live-heading button",
      "waitFor": ".bdna-shop-form",
      "assertions": [
        {
          "type": "count",
          "selector": ".bdna-shop-form select",
          "value": 1
        },
        {
          "type": "count",
          "selector": ".bdna-shop-form input[type=url]",
          "value": 1
        },
        {
          "type": "no-viewport-overflow",
          "selector": "html",
          "maxPx": 0
        }
      ]
    },
    {
      "name": "close-shop-form",
      "click": ".bdna-live-heading button",
      "assertions": [
        {
          "type": "hidden",
          "selector": ".bdna-shop-form"
        }
      ]
    },
    {
      "name": "shop-document-review-read-only",
      "click": ".bdna-review-toggle button",
      "waitFor": ".bdna-access-review",
      "assertions": [
        {"type": "visible", "selector": ".bdna-access-review"},
        {"type": "text-includes", "selector": ".bdna-access-review small", "value": "không kích hoạt tác vụ"},
        {"type": "no-viewport-overflow", "selector": "html", "maxPx": 0}
      ]
    },
    {
      "name": "scanner-registry",
      "click": "#bdna-stage-scanner",
      "waitFor": ".bdna-worker-enroll",
      "assertions": [
        {
          "type": "attribute",
          "selector": "#bdna-stage-scanner",
          "name": "aria-selected",
          "value": "true"
        },
        {
          "type": "visible",
          "selector": ".bdna-worker-manager"
        },
        {
          "type": "no-viewport-overflow",
          "selector": "html",
          "maxPx": 0
        }
      ]
    },
    {
      "name": "products-evidence-stage",
      "click": "#bdna-stage-products",
      "waitFor": ".bdna-evidence",
      "assertions": [
        {
          "type": "visible",
          "selector": ".bdna-evidence"
        },
        {
          "type": "visible",
          "selector": ".bdna-import-file input[type=file]"
        },
        {
          "type": "text-includes",
          "selector": ".bdna-import",
          "value": "Không tải ảnh"
        },
        {
          "type": "no-viewport-overflow",
          "selector": "html",
          "maxPx": 0
        }
      ]
    },
    {
      "name": "evidence-assessment-stays-unverified",
      "click": ".bdna-evidence-row",
      "waitFor": ".bdna-assessment",
      "assertions": [
        {
          "type": "visible",
          "selector": ".bdna-assessment"
        },
        {
          "type": "text-includes",
          "selector": ".bdna-assessment",
          "value": "không chuyển dữ liệu thành verified"
        },
        {
          "type": "no-viewport-overflow",
          "selector": "html",
          "maxPx": 0
        }
      ]
    },
    {
      "name": "dna-readiness-stage",
      "click": "#bdna-stage-dna",
      "waitFor": ".bdna-readiness",
      "assertions": [
        {
          "type": "visible",
          "selector": ".bdna-readiness"
        },
        {
          "type": "no-viewport-overflow",
          "selector": "html",
          "maxPx": 0
        }
      ]
    },
    {
      "name": "dna-draft-preview-keeps-unsupported-claims-blocked",
      "click": ".bdna-draft-head button",
      "waitFor": ".bdna-draft-result",
      "assertions": [
        {
          "type": "visible",
          "selector": ".bdna-draft-result"
        },
        {
          "type": "text-includes",
          "selector": ".bdna-draft-summary",
          "value": "Chưa đủ dữ kiện"
        },
        {
          "type": "visible",
          "selector": ".bdna-version"
        },
        {
          "type": "text-includes",
          "selector": ".bdna-version-blocked",
          "value": "Chưa đủ listing đã xác minh"
        },
        {
          "type": "no-viewport-overflow",
          "selector": "html",
          "maxPx": 0
        }
      ]
    },
    {
      "name": "return-overview",
      "click": "#bdna-stage-overview",
      "waitFor": ".bdna-workflow-overview",
      "assertions": [
        {
          "type": "attribute",
          "selector": "#bdna-stage-overview",
          "name": "aria-selected",
          "value": "true"
        },
        {
          "type": "no-viewport-overflow",
          "selector": "html",
          "maxPx": 0
        }
      ]
    }
  ]
}
