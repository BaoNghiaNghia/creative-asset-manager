GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
CLIENT_URL=http://localhost:5173

# Persistent OAuth and distributed sessions (Step 30).
# Keep keys in a deployment secret manager. Format: version:urlsafe-base64-32-byte-key
PERSISTENT_AUTH_ENABLED=false
OAUTH_TOKEN_ENCRYPTION_KEYS=
OAUTH_ACTIVE_KEY_VERSION=v1
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_STATE_TTL_SECONDS=600
AUTH_REFRESH_LEASE_SECONDS=30
APP_ENV=development
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/
AUTH_COOKIE_DOMAIN=


# Optional developer fallback. OAuth sessions take precedence.
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_ROOT_ID=root

# Microsoft Entra ID / SharePoint
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/auth/microsoft/callback
SHAREPOINT_ACCESS_TOKEN=

# Optional: restrict discovery to one known SharePoint site.
# Example: contoso.sharepoint.com and sites/Creative
SHAREPOINT_SITE_HOSTNAME=
SHAREPOINT_SITE_PATH=

DIRECTUS_URL=http://localhost:8055
DIRECTUS_TOKEN=

DIRECTUS_METADATA_COLLECTION=asset_metadata
DIRECTUS_METADATA_TTL_SECONDS=3600
DIRECTUS_METADATA_MAX_ITEMS=20000
DIRECTUS_METADATA_CONCURRENCY=6

# App-owned metadata database. SQLite works out of the box for local development.
# Production example: postgresql+psycopg://cam:password@postgres:5432/cam
DATABASE_URL=

# Architecture rollout feature flags. Step 01 validates these only.
# All new runtime paths remain disabled by default.
UNIFIED_ASSET_INGESTION_ENABLED=false
CONTENT_DEDUP_ENABLED=false
INCREMENTAL_SOURCE_SYNC_ENABLED=false
PROCESSING_JOBS_ENABLED=false
EXTERNAL_ASSET_DOWNLOADER_ENABLED=false
MANAGED_ASSET_STORAGE_ENABLED=false

# Step 24 single-asset Gemini analysis. Credentials are validated only when
# DYNAMIC_AI_METADATA_ENABLED and AI_SINGLE_ANALYSIS_ENABLED are both true.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=45
AI_STORE_RAW_RESPONSE_ENABLED=false
AI_ANALYSIS_LEASE_SECONDS=300
AI_ANALYSIS_MAX_SOURCE_BYTES=25000000
AI_ANALYSIS_MAX_OUTPUT_BYTES=8000000
AI_ANALYSIS_MAX_WIDTH=4096
AI_ANALYSIS_MAX_HEIGHT=4096
AI_ANALYSIS_MAX_PIXELS=24000000
AI_ANALYSIS_JPEG_QUALITY=88
AI_ANALYSIS_MAX_VALIDATION_ATTEMPTS=2
GOOGLE_MANAGED_STORAGE_ACCESS_TOKEN=
GOOGLE_MANAGED_STORAGE_ROOT_FOLDER_ID=

DYNAMIC_AI_METADATA_ENABLED=false
AI_SINGLE_ANALYSIS_ENABLED=false
AI_BATCH_ANALYSIS_ENABLED=false
AI_AUTO_ANALYZE_ENABLED=false

SEARCH_PROJECTION_ENABLED=false
ELASTICSEARCH_V2_ENABLED=false
SEARCH_QUERY_PARSER_V2_ENABLED=false

EXTERNAL_INGESTION_API_ENABLED=false
DRIVE_METADATA_SIDECAR_ENABLED=false

# Search v2 (still gated globally and per tenant)
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX_PREFIX=creative-assets

# Step 32 sensitive URL encryption and bounded retention cleanup.
# Use a dedicated key ring; do not reuse OAuth token keys.
SENSITIVE_URL_ENCRYPTION_KEYS=
SENSITIVE_URL_ACTIVE_KEY_VERSION=v1
RETENTION_CLEANUP_ENABLED=false
RETENTION_INGESTION_URL_HOURS=24
RETENTION_COMPLETED_INGESTION_DAYS=30
RETENTION_RAW_AI_RESPONSE_DAYS=7
RETENTION_COMPLETED_JOB_DAYS=30
RETENTION_DEAD_LETTER_DAYS=30
RETENTION_RATE_LIMIT_HOURS=2
RETENTION_OUTBOX_DAYS=30
RETENTION_TEMP_EXPORT_DAYS=7
RETENTION_SOURCE_SYNC_RUN_DAYS=30
RETENTION_CLEANUP_BATCH_SIZE=500
RETENTION_CLEANUP_MAX_ROWS=5000
RETENTION_CLEANUP_INTERVAL_SECONDS=86400
