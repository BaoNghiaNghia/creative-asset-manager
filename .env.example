GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Persistent OAuth and distributed sessions (Step 30).
# Keep keys in a deployment secret manager. Format: version:urlsafe-base64-32-byte-key
PERSISTENT_AUTH_ENABLED=false
OAUTH_TOKEN_ENCRYPTION_KEYS=
OAUTH_ACTIVE_KEY_VERSION=v1
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_STATE_TTL_SECONDS=600
AUTH_REFRESH_LEASE_SECONDS=30
# First local administrator bootstrap: explicitly set this and
# AUTH_SELF_SIGNUP_ENABLED=true in the ignored apps/api/.env, sign in once,
# run scripts/setup-admin.sh, then disable self-signup again if desired.
# Never enable personal tenant bootstrap in production.
DEVELOPMENT_PERSONAL_TENANT_ENABLED=false
# Deprecated migration-only adapter. Keep false except for a bounded AUTH-04
# transition from PROCESSING_POLICY_ADMIN_IDS to durable platform assignments.
AUTH_PROCESSING_ADMIN_ALLOWLIST_COMPAT_ENABLED=false
PROCESSING_POLICY_ADMIN_IDS=
# Application-login admission. Self-signup stays fail-closed by default.
AUTH_SELF_SIGNUP_ENABLED=false
# Required when production self-signup is explicitly enabled.
AUTH_DEFAULT_TENANT_ID=
# Comma-separated admission domains; this never grants roles.
AUTH_ALLOWED_EMAIL_DOMAINS=
# Active, pre-seeded tenant role assigned to approved self-signups.
# tenant_admin and platform_admin are rejected. viewer is least privilege.
AUTH_SELF_SIGNUP_DEFAULT_ROLE=viewer
# Optional ISO-8601 deadline for accepting legacy actor-only sessions.
AUTH_LEGACY_ACTOR_SESSION_COMPAT_UNTIL=


APP_ENV=development

# Public browser URL and API HTTP security.
# Development keeps Vite on localhost and proxies relative /api requests.
# Production must use a non-local HTTPS PUBLIC_APP_URL, explicit TRUSTED_HOSTS,
# API_DOCS_ENABLED=false, and either empty CORS (same-origin) or exact HTTPS origins.
PUBLIC_APP_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
API_DOCS_ENABLED=true
APP_VERSION=0.4.0
BUILD_COMMIT=unknown
PROXY_HEADERS_ENABLED=false
# Comma-separated proxy IPs/CIDRs. Wildcard trust is rejected.
PROXY_TRUSTED_IPS=127.0.0.1,::1
HEALTHCHECK_TIMEOUT_SECONDS=2
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/
AUTH_COOKIE_DOMAIN=


# Optional developer fallback. OAuth sessions take precedence.
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_ROOT_ID=root

# Microsoft Entra ID / SharePoint
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/auth/microsoft/callback
SHAREPOINT_ACCESS_TOKEN=

# Optional: restrict discovery to one known SharePoint site.
# Example: contoso.sharepoint.com and sites/Creative
SHAREPOINT_SITE_HOSTNAME=
SHAREPOINT_SITE_PATH=

DIRECTUS_URL=http://localhost:8055
DIRECTUS_TOKEN=

DIRECTUS_METADATA_COLLECTION=asset_metadata
DIRECTUS_METADATA_TTL_SECONDS=3600
DIRECTUS_METADATA_MAX_ITEMS=20000
DIRECTUS_METADATA_CONCURRENCY=6

# App-owned metadata database. SQLite works locally; production requires a non-SQLite URL.
# Production schema upgrades must run separately with: python -m alembic upgrade head
# Production example: postgresql+psycopg://cam:password@postgres:5432/cam
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Architecture rollout feature flags. Step 01 validates these only.
# All new runtime paths remain disabled by default.
UNIFIED_ASSET_INGESTION_ENABLED=false
CONTENT_DEDUP_ENABLED=false
INCREMENTAL_SOURCE_SYNC_ENABLED=false
SOURCE_SYNC_SCHEDULER_ENABLED=false
SOURCE_SYNC_POLL_INTERVAL_SECONDS=60
SOURCE_SYNC_MAX_SOURCES_PER_TICK=100
SOURCE_SYNC_JOB_STALE_SECONDS=900
GOOGLE_AUTO_SCAN_ON_LOGIN_ENABLED=false
GOOGLE_FULL_SCAN_ON_FIRST_LOGIN_ENABLED=false
PROCESSING_JOBS_ENABLED=false
EXTERNAL_ASSET_DOWNLOADER_ENABLED=false
MANAGED_ASSET_STORAGE_ENABLED=false

# Gemini single and batch analysis. Batch analysis currently requires Gemini;
# single analysis may instead use an enabled OpenAI provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ALLOWED_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash,gemini-2.5-flash-lite,gemini-2.5-flash
# Single-image failover order. Requests use one model at a time.
GEMINI_MODEL_POOL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash,gemini-2.5-flash-lite,gemini-2.5-flash
# Optional per-model quotas as JSON, e.g.
# {"gemini-3.5-flash-lite":{"rpm":12,"tpm":200000,"rpd":400}}
GEMINI_MODEL_LIMITS=
GEMINI_MODEL_COOLDOWN_SECONDS=60
# Non-secret scope shared by every worker using this Google project.
GEMINI_PROJECT_QUOTA_SCOPE=creative-asset-manager
# Hard cap across every Gemini model for one provider quota day. Empty derives from model RPD limits.
GEMINI_PROJECT_DAILY_REQUEST_LIMIT=848
# Per-provider/model RPM. JSON supports all models; named values are convenient overrides.
AI_MODEL_RPM_LIMITS=
AI_JOB_RATE_LIMIT_SAFETY_SECONDS=0.5
AI_MODEL_RPM_GEMINI_2_5_FLASH=5
AI_MODEL_RPM_GPT_4_1_MINI=3
AI_JOB_MIN_INTERVAL_SECONDS=10
AI_RATE_LIMIT_429_MAX_RETRIES=8
AI_RATE_LIMIT_BACKOFF_MAX_SECONDS=300
GEMINI_TIMEOUT_SECONDS=45
# OpenAI Responses API single-image analysis. Keep disabled until the key,
# model allowlist, tenant policy and budget controls are configured.
OPENAI_AI_ENABLED=false
GEMINI_EMERGENCY_STOP_ENABLED=false
OPENAI_EMERGENCY_STOP_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_DEFAULT_MODEL=
OPENAI_ALLOWED_MODELS=
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
OPENAI_IMAGE_DETAIL=auto
OPENAI_STORE_RESPONSES=false
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_BATCH_ENABLED=false
OPENAI_BATCH_COMPLETION_WINDOW=24h
OPENAI_BATCH_MAX_ITEMS=1000
OPENAI_BATCH_MAX_FILE_BYTES=150000000
OPENAI_BATCH_POLL_INTERVAL_SECONDS=60
OPENAI_BATCH_RESULT_PAGE_OR_CHUNK_SIZE=65536
OPENAI_BATCH_INPUT_RETENTION_HOURS=24
OPENAI_BATCH_OUTPUT_RETENTION_HOURS=24
AI_STORE_RAW_RESPONSE_ENABLED=false
AI_ANALYSIS_LEASE_SECONDS=300
AI_ANALYSIS_MAX_SOURCE_BYTES=25000000
AI_ANALYSIS_MAX_OUTPUT_BYTES=8000000
AI_ANALYSIS_MAX_WIDTH=4096
AI_ANALYSIS_MAX_HEIGHT=4096
AI_ANALYSIS_MAX_PIXELS=24000000
AI_ANALYSIS_JPEG_QUALITY=88
AI_ANALYSIS_MAX_VALIDATION_ATTEMPTS=2
AI_ANALYSIS_BULK_MAX_ITEMS=100
AI_ANALYSIS_BULK_MAX_PAYLOAD_BYTES=262144
GOOGLE_MANAGED_STORAGE_ACCESS_TOKEN=
GOOGLE_MANAGED_STORAGE_REFRESH_TOKEN=
GOOGLE_MANAGED_STORAGE_ROOT_FOLDER_ID=

DYNAMIC_AI_METADATA_ENABLED=false
AI_SINGLE_ANALYSIS_ENABLED=false
AI_BATCH_ANALYSIS_ENABLED=false
AI_AUTO_ANALYZE_ENABLED=false

SEARCH_PROJECTION_ENABLED=false
ELASTICSEARCH_V2_ENABLED=false
SEARCH_V3_ENABLED=false
SEARCH_V3_REQUIRED=true
SEARCH_QUERY_PARSER_V2_ENABLED=false

EXTERNAL_INGESTION_API_ENABLED=false
DRIVE_METADATA_SIDECAR_ENABLED=false

# Search v2 (still gated globally and per tenant)
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX_PREFIX=creative-assets

# Step 32 sensitive URL encryption and bounded retention cleanup.
# Use a dedicated key ring; do not reuse OAuth token keys.
SENSITIVE_URL_ENCRYPTION_KEYS=
SENSITIVE_URL_ACTIVE_KEY_VERSION=v1
RETENTION_CLEANUP_ENABLED=false
RETENTION_INGESTION_URL_HOURS=24
RETENTION_COMPLETED_INGESTION_DAYS=30
RETENTION_RAW_AI_RESPONSE_DAYS=7
RETENTION_COMPLETED_JOB_DAYS=30
RETENTION_DEAD_LETTER_DAYS=30
RETENTION_RATE_LIMIT_HOURS=2
RETENTION_OUTBOX_DAYS=30
RETENTION_TEMP_EXPORT_DAYS=7
RETENTION_SOURCE_SYNC_RUN_DAYS=30
RETENTION_CLEANUP_BATCH_SIZE=500
RETENTION_CLEANUP_MAX_ROWS=5000
RETENTION_CLEANUP_INTERVAL_SECONDS=86400
