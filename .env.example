GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_OAUTH_COOKIE_SECURE=false
CLIENT_URL=http://localhost:5173

# Optional developer fallback. OAuth sessions take precedence.
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_ROOT_ID=root

# Microsoft Entra ID / SharePoint
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/auth/microsoft/callback
MICROSOFT_OAUTH_COOKIE_SECURE=false
SHAREPOINT_ACCESS_TOKEN=

# Optional: restrict discovery to one known SharePoint site.
# Example: contoso.sharepoint.com and sites/Creative
SHAREPOINT_SITE_HOSTNAME=
SHAREPOINT_SITE_PATH=

DIRECTUS_URL=http://localhost:8055
DIRECTUS_TOKEN=

DIRECTUS_METADATA_COLLECTION=asset_metadata
DIRECTUS_METADATA_TTL_SECONDS=3600
DIRECTUS_METADATA_MAX_ITEMS=20000
DIRECTUS_METADATA_CONCURRENCY=6
