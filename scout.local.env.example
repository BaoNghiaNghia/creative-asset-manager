# Local-only Pinterest Scout configuration.
# Copy is created automatically as scout.local.env on first START_SCOUT.bat run.
# scout.local.env is ignored by Git and must never be committed.

RRUGC_BASE_URL=https://creative-assets.ddns.net

# Required: copy these from Realistic Review UGC > Scout Agent pairing.
RRUGC_AGENT_ID=
RRUGC_SCOUT_TOKEN=

# Defaults are normally correct for D:\Bot_Tool_Auto_Game\scan_pinterest.
# Leave blank to use <repo>\pinterest-profile.
RRUGC_PROFILE_DIR=

# Optional.
RRUGC_MACHINE_LABEL=
RRUGC_PACE=careful
RRUGC_DETAIL_CONCURRENCY=1
RRUGC_CHROME_EXECUTABLE=
RRUGC_PYTHON=
