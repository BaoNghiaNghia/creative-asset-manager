# Local-only Pinterest Scout configuration.
# Copy is created automatically as scout.local.env on first START_SCOUT.bat run.
# scout.local.env is ignored by Git and must never be committed.

RRUGC_BASE_URL=https://creative-assets.ddns.net

# Required: copy these from Realistic Review UGC > Scout Agent pairing.
RRUGC_AGENT_ID=
RRUGC_SCOUT_TOKEN=

# TikTokShop Stage 3 uses a DIFFERENT paired CAM Scout Agent and Chrome profile.
# Copy one-time credentials from CAM > Tiktokshop > Scout & UGC.
# Do not reuse RRUGC_AGENT_ID/RRUGC_SCOUT_TOKEN or commit scout.local.env.
RRUGC_TIKTOKSHOP_AGENT_ID=
RRUGC_TIKTOKSHOP_SCOUT_TOKEN=
# Leave blank for <repo>\pinterest-profile-tiktokshop
RRUGC_TIKTOKSHOP_PROFILE_DIR=

# Defaults are normally correct for D:\Bot_Tool_Auto_Game\scan_pinterest.
# Leave blank to use <repo>\pinterest-profile.
RRUGC_PROFILE_DIR=

# Keyword Scout uses a separate Chrome profile so it can run at the same time
# as Review Scout. Leave blank to use <repo>\pinterest-profile-keyword.
RRUGC_KEYWORD_PROFILE_DIR=

# Optional.
RRUGC_MACHINE_LABEL=
RRUGC_PACE=careful
RRUGC_DETAIL_CONCURRENCY=1
RRUGC_CHROME_EXECUTABLE=
# Optional: Typography uses system Chrome by default, matching the login window.
# Set a dedicated executable only if it matches the saved Typography profile.
RRUGC_TYPOGRAPHY_CHROME_EXECUTABLE=
RRUGC_PYTHON=
