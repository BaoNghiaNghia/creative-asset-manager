[Unit]
Description=Creative Asset Manager Inventory manual Morning Reset recovery
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
# Exit 2 means the recovery was safely blocked for operator review, not a process crash.
SuccessExitStatus=2
User=creative-assets
Group=creative-assets
WorkingDirectory=/opt/creative-asset-manager/current
EnvironmentFile=/etc/creative-asset-manager/production.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/creative-asset-manager/current/apps/api/.venv/bin/python /opt/creative-asset-manager/current/apps/inventory_scheduler/main.py --manual-recovery-current-day
TimeoutStartSec=30min
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
