[Unit]
Description=Creative Asset Manager isolated SigLIP visual encoder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=creative-assets
Group=creative-assets
WorkingDirectory=/opt/creative-asset-manager/current
EnvironmentFile=/etc/creative-asset-manager/production.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/creative-asset-manager/current/apps/api
ExecStartPre=/usr/bin/test -r /etc/creative-asset-manager/production.env
ExecStart=/var/lib/creative-asset-manager/visual-encoder-runtime/bin/python -m uvicorn --app-dir /opt/creative-asset-manager/current/apps/visual_encoder main:app --host 127.0.0.1 --port 8091 --no-proxy-headers
Restart=on-failure
RestartSec=10s
TimeoutStartSec=300s
TimeoutStopSec=30s
MemoryMax=1500M
CPUQuota=100%
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET
UMask=0027

[Install]
WantedBy=multi-user.target
