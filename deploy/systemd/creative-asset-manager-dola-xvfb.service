[Unit]
Description=Private Xvfb display for CAM Dola Render Gateway
After=network-online.target
Before=creative-asset-manager-dola-gateway.service

[Service]
Type=simple
User=dola-render-gateway
Group=dola-render-gateway
Environment=DISPLAY=:99
ExecStart=/usr/bin/Xvfb :99 -screen 0 1280x1024x24 -nolisten tcp -noreset
Restart=on-failure
RestartSec=3s

# Initial containment envelope; this is not a throughput guarantee.
MemoryAccounting=true
CPUAccounting=true
TasksAccounting=true
MemoryHigh=96M
MemoryMax=160M
CPUQuota=20%
TasksMax=64
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dola-render-gateway /run

[Install]
WantedBy=multi-user.target