[Unit]
Description=Creative Asset Manager quinary image processing worker
Documentation=file:/opt/creative-asset-manager/current/docs/operations/VPS_DEPLOYMENT.md
Wants=network-online.target
After=network-online.target postgresql.service docker.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=creative-assets
Group=creative-assets
WorkingDirectory=/opt/creative-asset-manager/current
EnvironmentFile=/etc/creative-asset-manager/production.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=MALLOC_ARENA_MAX=2
Environment=MALLOC_TRIM_THRESHOLD_=131072
Environment=DATABASE_POOL_SIZE=2
Environment=DATABASE_MAX_OVERFLOW=0
Environment=WORKER_ROLE=image
Environment=WORKER_RUN_OPERATIONAL_SCHEDULERS=false
Environment=WORKER_ID=creativeasset-image-quinary
Environment=WORKER_HEALTH_PORT=8086
ExecStartPre=/usr/bin/test -r /etc/creative-asset-manager/production.env
ExecStart=/opt/creative-asset-manager/current/apps/api/.venv/bin/python /opt/creative-asset-manager/current/apps/worker/main.py
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=45s
KillSignal=SIGTERM
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StateDirectory=creative-asset-manager
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
