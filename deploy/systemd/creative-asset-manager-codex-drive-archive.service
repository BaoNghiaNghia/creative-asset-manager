[Unit]
Description=CAM Codex PNG archive to Managed Drive with post-upload verification
After=network-online.target postgresql.service
Wants=network-online.target
ConditionPathExists=/opt/creative-asset-manager/current/scripts/cam-codex-drive-archive.py

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/creative-asset-manager/production.env
ExecStart=/opt/creative-asset-manager/current/apps/api/.venv/bin/python /opt/creative-asset-manager/current/scripts/cam-codex-drive-archive.py --apply --max-files 500 --min-age-hours 4 --concurrency 5
TimeoutStartSec=50min
Nice=15
IOSchedulingClass=idle
CPUQuota=60%
MemoryMax=768M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/creative-asset-manager/codex/generated_images /var/lib/creative-asset-manager/codex-account-2/generated_images
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0077
