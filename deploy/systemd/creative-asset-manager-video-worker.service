[Unit]
Description=Creative Asset Manager heavy video processing worker
Documentation=file:/opt/creative-asset-manager/current/docs/operations/VPS_DEPLOYMENT.md
Wants=network-online.target
After=network-online.target postgresql.service docker.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=creative-assets
Group=creative-assets
WorkingDirectory=/opt/creative-asset-manager/current
EnvironmentFile=/etc/creative-asset-manager/production.env
# Optional Dola bearer/config is scoped to the video worker only.
EnvironmentFile=-/etc/creative-asset-manager/video-worker.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=WORKER_ROLE=video-heavy
Environment=WORKER_ID=creativeasset-video-heavy
Environment=WORKER_HEALTH_PORT=8082
Environment=VIDEO_PROXY_HOST_SOURCE_CEILING_BYTES=1500000000
Environment=VIDEO_PROXY_MIN_FREE_DISK_BYTES=8589934592
ExecStartPre=/usr/bin/test -r /etc/creative-asset-manager/production.env
ExecStart=/opt/creative-asset-manager/current/apps/api/.venv/bin/python /opt/creative-asset-manager/current/apps/worker/main.py
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=45s
KillSignal=SIGTERM
CPUQuota=100%
MemoryHigh=1G
MemoryMax=1536M
TasksMax=64
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StateDirectory=creative-asset-manager
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
