# Install ONLY as /etc/creative-asset-manager/database-backup.env,
# owned by root:root and mode 0600. Never commit a populated copy.
# Loaded only by creative-asset-manager-db-backup.service.
# Separate PostgreSQL login, read-only across the exact SAME host/port/database
# as DATABASE_URL from production.env. Must include all incident recovery tables.
# Do not use cam_app, postgres/superuser, or application-wide roles.
DATABASE_BACKUP_DATABASE_URL=
