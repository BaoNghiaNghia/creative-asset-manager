# Copy to /etc/dola-render-gateway/production.env. Root-owned, mode 0640.
# This file is intentionally safe to commit. Set DOLA_INTERNAL_API_KEY out-of-band.
DOLA_CAM_INTERNAL_MODE=1
DOLA_GATEWAY_HOST=127.0.0.1
DOLA_GATEWAY_PORT=8100
DOLA_ALLOW_NON_LOOPBACK=false
DOLA_INTERNAL_API_KEY=

# The wrapper rejects an empty key at service start; never use a placeholder.
DOLA_MAX_CONCURRENCY=1
DOLA_MAX_PENDING_TASKS=20
DOLA_VIDEO_TIMEOUT=300
DOLA_REFERENCE_VIDEO_TIMEOUT=900

# All persistent execution and account state is outside the immutable release.
DOLA_STATE_ROOT=/var/lib/dola-render-gateway
DOLA_RUNTIME_ROOT=/var/lib/dola-render-gateway/current-runtime
DOLA_DB_PATH=/var/lib/dola-render-gateway/db/tasks.db
DOLA_POOL_DB_PATH=/var/lib/dola-render-gateway/db/pool_usage.db
DOLA_PROFILE_DIR=/var/lib/dola-render-gateway/profiles
DOLA_DOWNLOAD_DIR=/var/lib/dola-render-gateway/downloads
DOLA_ARTIFACTS_DIR=/var/lib/dola-render-gateway/artifacts
DOLA_RUNTIME_TMP_DIR=/var/lib/dola-render-gateway/current-runtime/tmp
DOLA_EXTENSION_DIR=/opt/dola-render-gateway/current/apps/dola_render_gateway/upstream/extensions/dola30

# Explicitly empty means no proxy is configured; do not inherit an accidental proxy.
DOLA_PROXY=
DOLA_HEADLESS=1
DOLA_EXTENSION_ENABLED=1
DOLA_REFERENCE_IMAGE_MAX_BYTES=15728640
DOLA_REFERENCE_IMAGE_MAX_COUNT=30
DOLA_LIMIT_RESET_TZ=Asia/Tokyo