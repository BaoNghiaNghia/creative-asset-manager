# Copy to /etc/creative-asset-manager/production.env, set owner root and mode 0640.
# Replace every REPLACE_* value. Never commit the populated file.
APP_ENV=production
PUBLIC_APP_URL=https://assets.example.com
CORS_ALLOWED_ORIGINS=
TRUSTED_HOSTS=assets.example.com
API_DOCS_ENABLED=false
APP_VERSION=0.4.0
BUILD_COMMIT=REPLACE_GIT_COMMIT
# Docker resource limits are safe measured defaults; tune them for the VPS.
# Keep ES heap below its container memory limit.
CAM_BACKEND_IMAGE=creative-asset-manager-backend
CAM_API_CPU_LIMIT=1.0
CAM_API_MEMORY_LIMIT=1g
CAM_WORKER_CPU_LIMIT=1.0
CAM_WORKER_MEMORY_LIMIT=2g
CAM_MIGRATE_CPU_LIMIT=1.0
CAM_MIGRATE_MEMORY_LIMIT=1g
CAM_ELASTICSEARCH_CPU_LIMIT=2.0
CAM_ELASTICSEARCH_MEMORY_LIMIT=2g
ES_JAVA_OPTS=-Xms1g -Xmx1g

# Nginx reaches the API through the loopback-published container port.
# The fixed Compose bridge gateway is the only trusted forwarded-header peer.
PROXY_HEADERS_ENABLED=true
PROXY_TRUSTED_IPS=172.29.0.1/32
HEALTHCHECK_TIMEOUT_SECONDS=2

# Native PostgreSQL reached from Docker; allow only 172.29.0.0/24 in pg_hba.conf.
DATABASE_URL=postgresql+psycopg://cam_app:REPLACE_DATABASE_PASSWORD@host.docker.internal:5432/creative_asset_manager
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Docker Compose service URL; the optional host port remains loopback-only.
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX_PREFIX=creative-assets

# Secure same-origin browser sessions.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/
AUTH_COOKIE_DOMAIN=
PERSISTENT_AUTH_ENABLED=true
OAUTH_TOKEN_ENCRYPTION_KEYS=
OAUTH_ACTIVE_KEY_VERSION=v1
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_STATE_TTL_SECONDS=600
AUTH_REFRESH_LEASE_SECONDS=30
# Must remain false in production; bootstrap tenants with the operator CLI.
DEVELOPMENT_PERSONAL_TENANT_ENABLED=false
AUTH_SELF_SIGNUP_ENABLED=false
AUTH_DEFAULT_TENANT_ID=
# Admission only; domains never imply tenant or platform administration.
AUTH_ALLOWED_EMAIL_DOMAINS=
# Must name an active role already seeded in AUTH_DEFAULT_TENANT_ID.
# Administrative roles are rejected; viewer is the safe default.
AUTH_SELF_SIGNUP_DEFAULT_ROLE=viewer
# Set only for a bounded rolling-deployment window, then remove it.
AUTH_LEGACY_ACTOR_SESSION_COMPAT_UNTIL=

AUTH_PROCESSING_ADMIN_ALLOWLIST_COMPAT_ENABLED=false

# OAuth providers. Keep blank until configured in the provider console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://assets.example.com/api/auth/google/callback
GOOGLE_DRIVE_ROOT_ID=root
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations
MICROSOFT_REDIRECT_URI=https://assets.example.com/api/auth/microsoft/callback
SHAREPOINT_SITE_HOSTNAME=
SHAREPOINT_SITE_PATH=

# Optional external systems and managed storage.
DIRECTUS_URL=
DIRECTUS_TOKEN=
DIRECTUS_METADATA_COLLECTION=asset_metadata
DIRECTUS_METADATA_TTL_SECONDS=3600
DIRECTUS_METADATA_MAX_ITEMS=20000
DIRECTUS_METADATA_CONCURRENCY=6
GOOGLE_MANAGED_STORAGE_ACCESS_TOKEN=
GOOGLE_MANAGED_STORAGE_REFRESH_TOKEN=
GOOGLE_MANAGED_STORAGE_ROOT_FOLDER_ID=

# AI remains disabled until credentials, tenant policy and budgets are ready.
# Required only to save a tenant-scoped Creative Gemini key from AI Operations. Generate an independent 32-byte urlsafe-base64 value; do not reuse Inventory or OAuth encryption keys.
CREATIVE_AI_CREDENTIAL_ENCRYPTION_KEY=
# Emergency deployment-managed Creative Gemini fallback. Database credentials override this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ALLOWED_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.7-flash,gemini-2.5-flash-lite,gemini-2.5-flash
GEMINI_MODEL_POOL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.7-flash,gemini-2.5-flash-lite,gemini-2.5-flash
# Optional JSON per-model quotas: {"model":{"rpm":12,"tpm":200000,"rpd":400}}
GEMINI_MODEL_LIMITS=
GEMINI_MODEL_COOLDOWN_SECONDS=60
# Non-secret scope shared by every worker using this Google project.
GEMINI_PROJECT_QUOTA_SCOPE=creative-asset-manager
# Hard cap across every Gemini model for one provider quota day. Empty derives from model RPD limits.
GEMINI_PROJECT_DAILY_REQUEST_LIMIT=868
# Per-provider/model RPM. JSON supports all models; named values are convenient overrides.
AI_MODEL_RPM_LIMITS=
AI_JOB_RATE_LIMIT_SAFETY_SECONDS=0.5
AI_MODEL_RPM_GEMINI_2_5_FLASH=5
AI_MODEL_RPM_GPT_4_1_MINI=3
AI_JOB_MIN_INTERVAL_SECONDS=10
AI_RATE_LIMIT_429_MAX_RETRIES=8
AI_RATE_LIMIT_BACKOFF_MAX_SECONDS=300
GEMINI_TIMEOUT_SECONDS=45
# OpenAI Responses API single-image analysis. Keep disabled until the key,
# model allowlist, tenant policy and budget controls are configured.
OPENAI_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_DEFAULT_MODEL=
OPENAI_ALLOWED_MODELS=
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
OPENAI_IMAGE_DETAIL=auto
OPENAI_STORE_RESPONSES=false
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_BATCH_ENABLED=false
OPENAI_BATCH_COMPLETION_WINDOW=24h
OPENAI_BATCH_MAX_ITEMS=1000
OPENAI_BATCH_MAX_FILE_BYTES=150000000
OPENAI_BATCH_POLL_INTERVAL_SECONDS=60
OPENAI_BATCH_RESULT_PAGE_OR_CHUNK_SIZE=65536
OPENAI_BATCH_INPUT_RETENTION_HOURS=24
OPENAI_BATCH_OUTPUT_RETENTION_HOURS=24
AI_EMERGENCY_STOP_ENABLED=true
GEMINI_EMERGENCY_STOP_ENABLED=false
OPENAI_EMERGENCY_STOP_ENABLED=false
AI_STORE_RAW_RESPONSE_ENABLED=false

# Worker lifecycle. Keep processing off for the first deployment.
WORKER_ID=
# Native unit files override this with image or video; all preserves local compatibility.
WORKER_ROLE=all
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
WORKER_IDLE_POLL_SECONDS=2
WORKER_DRAIN_TIMEOUT_SECONDS=30
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=8081
WORKER_LOG_LEVEL=INFO
PROCESSING_POLICY_CACHE_TTL_SECONDS=5
PROCESSING_POLICY_ADMIN_IDS=

# Global feature flags are emergency upper bounds. Pipeline flags are off initially; the AI emergency stop above remains on.
UNIFIED_ASSET_INGESTION_ENABLED=false
CONTENT_DEDUP_ENABLED=false
INCREMENTAL_SOURCE_SYNC_ENABLED=false
SOURCE_SYNC_SCHEDULER_ENABLED=false
SOURCE_SYNC_POLL_INTERVAL_SECONDS=60
SOURCE_SYNC_MAX_SOURCES_PER_TICK=100
SOURCE_SYNC_JOB_STALE_SECONDS=900
GOOGLE_AUTO_SCAN_ON_LOGIN_ENABLED=false
GOOGLE_FULL_SCAN_ON_FIRST_LOGIN_ENABLED=false
PROCESSING_JOBS_ENABLED=false
INVENTORY_AUTOMATION_ENABLED=false
INVENTORY_WORKER_ENABLED=false
INVENTORY_DRIVE_POLLER_ENABLED=false
INVENTORY_DAILY_SCHEDULER_ENABLED=false
INVENTORY_DAILY_SCHEDULER_POLL_SECONDS=30
# Required only to save a tenant Gemini key from the Configuration UI. Generate an
# independent 32-byte urlsafe-base64 value; do not reuse OAuth encryption keys.
INVENTORY_CREDENTIAL_ENCRYPTION_KEY=
# Emergency deployment-managed Gemini fallback. It is never returned unmasked.
INVENTORY_GEMINI_API_KEY=
INVENTORY_WORKER_CONCURRENCY=1
INVENTORY_WORKER_LEASE_SECONDS=60
INVENTORY_WORKER_HEARTBEAT_SECONDS=15
INVENTORY_WORKER_IDLE_POLL_SECONDS=2
INVENTORY_WORKER_DRAIN_TIMEOUT_SECONDS=30
INVENTORY_WORKER_HEALTH_HOST=127.0.0.1
INVENTORY_WORKER_HEALTH_PORT=8082
EXTERNAL_ASSET_DOWNLOADER_ENABLED=false
MANAGED_ASSET_STORAGE_ENABLED=false
INVENTORY_SOURCE_STORAGE_ROOT=/var/lib/creative-asset-manager/inventory
INVENTORY_DOWNLOAD_MAX_BYTES=104857600
INVENTORY_PREPARE_MAX_SOURCE_BYTES=104857600
INVENTORY_PREPARE_MAX_SOURCE_WIDTH=20000
INVENTORY_PREPARE_MAX_SOURCE_HEIGHT=20000
INVENTORY_PREPARE_MAX_DECODE_PIXELS=120000000
INVENTORY_PREPARE_MAX_OUTPUT_BYTES=8388608
INVENTORY_PREPARE_MAX_WIDTH=2048
INVENTORY_PREPARE_MAX_HEIGHT=2048
INVENTORY_PREPARE_JPEG_QUALITY=85
DYNAMIC_AI_METADATA_ENABLED=false
AI_SINGLE_ANALYSIS_ENABLED=false
AI_BATCH_ANALYSIS_ENABLED=false
AI_AUTO_ANALYZE_ENABLED=false
AI_BATCH_FALLBACK_TO_SINGLE_ENABLED=false
AI_ANALYSIS_BULK_MAX_ITEMS=100
AI_ANALYSIS_BULK_MAX_PAYLOAD_BYTES=262144
SEARCH_PROJECTION_ENABLED=false
ELASTICSEARCH_V2_ENABLED=false
SEARCH_V3_ENABLED=false
SEARCH_V3_REQUIRED=true
SEARCH_QUERY_PARSER_V2_ENABLED=false
DETERMINISTIC_ACTIVE_ANALYSIS_ENABLED=false
SEARCH_SHADOW_COMPARISON_ENABLED=false
ELASTICSEARCH_INDEX_LIFECYCLE_ENABLED=false
# Video search rollout remains disabled until a controlled tenant pilot.
VIDEO_SEARCH_ENABLED=false
VIDEO_ANALYSIS_ENABLED=false
VIDEO_PROXY_ENABLED=false
VIDEO_AI_TOKEN_SAFETY_RATIO=0.80
VIDEO_AI_DAILY_BUDGET_RATIO=0.90
VIDEO_AI_REQUIRE_EXPLICIT_MODEL_LIMITS=true
VIDEO_AI_PROMPT_VERSION=video-search-prompt-v1
VIDEO_AI_ANALYSIS_VERSION=video-search-analysis-v1
VIDEO_PROXY_MAX_WIDTH=1280
VIDEO_PROXY_MAX_HEIGHT=720
VIDEO_PROXY_FPS=15
VIDEO_PROXY_VIDEO_BITRATE_KBPS=1500
VIDEO_PROXY_AUDIO_BITRATE_KBPS=64
VIDEO_CHUNK_SECONDS=1200
VIDEO_PROXY_MAX_CHUNK_BYTES=1500000000
VIDEO_PROXY_MAX_SOURCE_BYTES=1500000000
VIDEO_TEMP_DIRECTORY=/var/lib/creative-asset-manager/video-proxy

EXTERNAL_INGESTION_API_ENABLED=false
DRIVE_METADATA_SIDECAR_ENABLED=false
RETENTION_CLEANUP_ENABLED=false

# Creative AI Managed Storage is temporary staging. Keep disabled until dry-run
# results and a small manual batch have been reviewed.
MANAGED_STORAGE_AUTO_CLEANUP_ENABLED=false
MANAGED_STORAGE_COMPLETED_RETENTION_HOURS=6
MANAGED_STORAGE_FAILED_RETENTION_HOURS=24
MANAGED_STORAGE_CLEANUP_INTERVAL_SECONDS=3600
MANAGED_STORAGE_CLEANUP_BATCH_SIZE=100
MANAGED_STORAGE_CLEANUP_MAX_ITEMS_PER_RUN=500

# Required before enabling persistent auth or external ingestion. Generate
# independent versioned 32-byte urlsafe-base64 keys; do not reuse keys.
SENSITIVE_URL_ENCRYPTION_KEYS=
SENSITIVE_URL_ACTIVE_KEY_VERSION=v1

# Retention defaults.
RETENTION_INGESTION_URL_HOURS=24
RETENTION_COMPLETED_INGESTION_DAYS=30
RETENTION_RAW_AI_RESPONSE_DAYS=7
RETENTION_COMPLETED_JOB_DAYS=30
RETENTION_DEAD_LETTER_DAYS=30
RETENTION_RATE_LIMIT_HOURS=2
RETENTION_OUTBOX_DAYS=30
RETENTION_TEMP_EXPORT_DAYS=7
RETENTION_SOURCE_SYNC_RUN_DAYS=30
RETENTION_CLEANUP_BATCH_SIZE=500
RETENTION_CLEANUP_MAX_ROWS=5000
RETENTION_CLEANUP_INTERVAL_SECONDS=86400

# Maximum original AVIF bytes accepted for browser-safe preview conversion.
AVIF_PREVIEW_MAX_INPUT_BYTES=25000000
