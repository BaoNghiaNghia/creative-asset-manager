# Copy to /etc/creative-asset-manager/production.env, set owner root and mode 0640.
# Replace every REPLACE_* value. Never commit the populated file.
APP_ENV=production
PUBLIC_APP_URL=https://assets.example.com
CORS_ALLOWED_ORIGINS=
TRUSTED_HOSTS=assets.example.com
API_DOCS_ENABLED=false
APP_VERSION=0.4.0
BUILD_COMMIT=REPLACE_GIT_COMMIT

# Nginx connects to the API from loopback. Uvicorn proxy handling is disabled
# in systemd so only the application middleware evaluates forwarded headers.
PROXY_HEADERS_ENABLED=true
PROXY_TRUSTED_IPS=127.0.0.1/32
HEALTHCHECK_TIMEOUT_SECONDS=2

# Native PostgreSQL; percent-encode reserved characters in the password.
DATABASE_URL=postgresql+psycopg://cam_app:REPLACE_DATABASE_PASSWORD@127.0.0.1:5432/creative_asset_manager
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Dockerized Elasticsearch is published to loopback only.
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX_PREFIX=creative-assets

# Secure same-origin browser sessions.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/
AUTH_COOKIE_DOMAIN=
PERSISTENT_AUTH_ENABLED=false
OAUTH_TOKEN_ENCRYPTION_KEYS=
OAUTH_ACTIVE_KEY_VERSION=v1
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_STATE_TTL_SECONDS=600
AUTH_REFRESH_LEASE_SECONDS=30

# OAuth providers. Keep blank until configured in the provider console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://assets.example.com/api/auth/google/callback
GOOGLE_DRIVE_ROOT_ID=root
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations
MICROSOFT_REDIRECT_URI=https://assets.example.com/api/auth/microsoft/callback
SHAREPOINT_SITE_HOSTNAME=
SHAREPOINT_SITE_PATH=

# Optional external systems and managed storage.
DIRECTUS_URL=
DIRECTUS_TOKEN=
DIRECTUS_METADATA_COLLECTION=asset_metadata
DIRECTUS_METADATA_TTL_SECONDS=3600
DIRECTUS_METADATA_MAX_ITEMS=20000
DIRECTUS_METADATA_CONCURRENCY=6
GOOGLE_MANAGED_STORAGE_ACCESS_TOKEN=
GOOGLE_MANAGED_STORAGE_ROOT_FOLDER_ID=

# AI remains disabled until credentials, tenant policy and budgets are ready.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=45
# OpenAI Responses API single-image analysis. Keep disabled until the key,
# model allowlist, tenant policy and budget controls are configured.
OPENAI_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_DEFAULT_MODEL=
OPENAI_ALLOWED_MODELS=
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
OPENAI_IMAGE_DETAIL=auto
OPENAI_STORE_RESPONSES=false
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_BATCH_ENABLED=false
OPENAI_BATCH_COMPLETION_WINDOW=24h
OPENAI_BATCH_MAX_ITEMS=1000
OPENAI_BATCH_MAX_FILE_BYTES=150000000
OPENAI_BATCH_POLL_INTERVAL_SECONDS=60
OPENAI_BATCH_RESULT_PAGE_OR_CHUNK_SIZE=65536
OPENAI_BATCH_INPUT_RETENTION_HOURS=24
OPENAI_BATCH_OUTPUT_RETENTION_HOURS=24
AI_EMERGENCY_STOP_ENABLED=true
AI_STORE_RAW_RESPONSE_ENABLED=false

# Worker lifecycle. Keep processing off for the first deployment.
WORKER_ID=
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
WORKER_IDLE_POLL_SECONDS=2
WORKER_DRAIN_TIMEOUT_SECONDS=30
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=8081
WORKER_LOG_LEVEL=INFO
PROCESSING_POLICY_CACHE_TTL_SECONDS=5
PROCESSING_POLICY_ADMIN_IDS=

# Global feature flags are emergency upper bounds. Pipeline flags are off initially; the AI emergency stop above remains on.
UNIFIED_ASSET_INGESTION_ENABLED=false
CONTENT_DEDUP_ENABLED=false
INCREMENTAL_SOURCE_SYNC_ENABLED=false
PROCESSING_JOBS_ENABLED=false
EXTERNAL_ASSET_DOWNLOADER_ENABLED=false
MANAGED_ASSET_STORAGE_ENABLED=false
DYNAMIC_AI_METADATA_ENABLED=false
AI_SINGLE_ANALYSIS_ENABLED=false
AI_BATCH_ANALYSIS_ENABLED=false
AI_AUTO_ANALYZE_ENABLED=false
AI_BATCH_FALLBACK_TO_SINGLE_ENABLED=false
SEARCH_PROJECTION_ENABLED=false
ELASTICSEARCH_V2_ENABLED=false
SEARCH_QUERY_PARSER_V2_ENABLED=false
DETERMINISTIC_ACTIVE_ANALYSIS_ENABLED=false
SEARCH_SHADOW_COMPARISON_ENABLED=false
ELASTICSEARCH_INDEX_LIFECYCLE_ENABLED=false
EXTERNAL_INGESTION_API_ENABLED=false
DRIVE_METADATA_SIDECAR_ENABLED=false
RETENTION_CLEANUP_ENABLED=false

# Required before enabling persistent auth or external ingestion. Generate
# independent versioned 32-byte urlsafe-base64 keys; do not reuse keys.
SENSITIVE_URL_ENCRYPTION_KEYS=
SENSITIVE_URL_ACTIVE_KEY_VERSION=v1

# Retention defaults.
RETENTION_INGESTION_URL_HOURS=24
RETENTION_COMPLETED_INGESTION_DAYS=30
RETENTION_RAW_AI_RESPONSE_DAYS=7
RETENTION_COMPLETED_JOB_DAYS=30
RETENTION_DEAD_LETTER_DAYS=30
RETENTION_RATE_LIMIT_HOURS=2
RETENTION_OUTBOX_DAYS=30
RETENTION_TEMP_EXPORT_DAYS=7
RETENTION_SOURCE_SYNC_RUN_DAYS=30
RETENTION_CLEANUP_BATCH_SIZE=500
RETENTION_CLEANUP_MAX_ROWS=5000
RETENTION_CLEANUP_INTERVAL_SECONDS=86400
