# Shell scripts must use Unix line endings, including on Windows checkouts.
*.sh text eol=lf
Makefile text eol=lf

# Keep source and configuration files consistent in WSL and CI.
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Committed production frontend artifacts must compare byte-for-byte in CI.
apps/client/dist/** text eol=lf

# Binary media must never be line-ending normalized, including inside dist.
*.png -text -eol
*.jpg -text -eol
*.jpeg -text -eol
*.gif -text -eol
*.webp -text -eol
*.ico -text -eol
