name = "cam-r2-original-video"
main = "src/index.ts"
compatibility_date = "2026-09-01"
workers_dev = false

# Replace with the actual PRIVATE bucket only during a separately approved rollout.
[[r2_buckets]]
binding = "VIDEO_CACHE_BUCKET"
bucket_name = "YOUR_PRIVATE_R2_BUCKET"

[vars]
R2_VIDEO_MEDIA_MAX_TTL_SECONDS = "3600"

# Set R2_VIDEO_MEDIA_SIGNING_SECRET with `wrangler secret put`; never in TOML.
